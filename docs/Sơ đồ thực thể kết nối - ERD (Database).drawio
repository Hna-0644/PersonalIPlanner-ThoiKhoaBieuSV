        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class UserController {\n        +register(req, res)\n        +login(req, res)\n        +getProfile(req, res)\n    }\n    class TaskService {\n        +createTask(data)\n        +getTasks(userId)\n        +updateTask(taskId, data)\n    }\n    class TimetableService {\n        +addClass(data)\n        +checkConflict(userId, startTime, endTime)\n        +getTimetable(userId)\n    }\n    class AutoScheduleService {\n        +generateSuggestedSchedule(userId)\n        -fetchFreeSlots(userId)\n        -assignTasksToSlots(tasks, slots)\n    }\n    class User {\n        +int id\n        +String email\n        +String password\n    }\n    class Task {\n        +int id\n        +int userId\n        +String title\n        +Date dueDate\n        +String status\n    }\n    class Timetable {\n        +int id\n        +int userId\n        +String subjectName\n        +Date startTime\n        +Date endTime\n    }\n\n    UserController --&gt; User\n    TaskService --&gt; Task\n    TimetableService --&gt; Timetable\n    AutoScheduleService ..&gt; TaskService : uses\n    AutoScheduleService ..&gt; TimetableService : uses&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="99gmn9KSdlg3Xpx5zCLs-1">
